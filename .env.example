# App (Vite — prefix VITE_ is embedded in the bundle)
VITE_APP_VERSION=0.1.0
VITE_IMAGE_VERSION=0.1.0-dev
# Optional: bake absolute OG/Twitter URLs at build time (no trailing slash).
# Leave empty / localhost / example.com → dist keeps __SITE_ORIGIN__ and nginx
# rewrites it from the request Host (recommended for Coolify).
VITE_SITE_URL=
VITE_AUTHOR_NAME=Gabriel Oliveira Brito
# Optional X/Twitter handles for twitter:site / twitter:creator (with or without @).
VITE_TWITTER_SITE=
VITE_TWITTER_CREATOR=

# Docker / release (CI and local builds; no VITE_ prefix required)
STRIP_SOURCE_MAPS=true
DOCKER_IMAGE=ghcr.io/gabrieloliveirabrito/media-comparer
